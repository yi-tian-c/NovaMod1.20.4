{
  "schemaVersion": 1,
  "id": "novamod",
  "version": "${version}",
  "name": "NovaMod",
  "description": "NovaMod content and rendering experiments.",
  "environment": "*",
  "entrypoints": {
    "main": [
      "org.novamod.NovaMod"
    ],
    "client": [
      "org.novamod.client.NovaModClient"
    ],
    "fabric-datagen": [
      "org.novamod.datagen.NovaModDataGenerator"
    ]
  },
  "mixins": [
    "novamod.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": "1.20.4",
    "java": ">=17",
    "fabric-api": "*"
  },
  "suggests": {
    "iris": "*"
  }
}
